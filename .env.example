# ============================================
# Personal Finance Pipeline — Variables de entorno
# ============================================
# Copiá este archivo a .env y completá con tus valores reales:
#   cp .env.example .env
# 
# El .env real NUNCA se commitea (está en .gitignore)
# ============================================

# --- Wallet API (BudgetBakers) ---
# Generá tu token en: https://web.budgetbakers.com/settings/apiTokens
WALLET_API_KEY=your_jwt_token_here
WALLET_API_BASE_URL=https://rest.budgetbakers.com/wallet

# --- Database (lo configuramos en sesión 2) ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Telegram Bot (lo configuramos en sesión 4) ---
# Creá tu bot con @BotFather en Telegram
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here

# --- Anthropic API (lo configuramos en sesión 6) ---
# Generá tu key en: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_key_here